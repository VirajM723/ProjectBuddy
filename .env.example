# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/project-buddy?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Optional: comma-separated emails that receive the admin role when they register
ADMIN_EMAIL=you@example.com

# Optional: Render sets this automatically
# PORT=3000
